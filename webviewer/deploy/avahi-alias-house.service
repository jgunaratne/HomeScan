# /etc/systemd/system/avahi-alias-house.service
[Unit]
Description=Publish house.local via mDNS
Requires=avahi-daemon.service
After=avahi-daemon.service network-online.target

[Service]
Type=simple
ExecStart=/mnt/usbdrive/HomeScan/webviewer/deploy/avahi-alias-house.sh
Restart=always
# A DHCP lease change moves the address; restarting re-resolves it.
RestartSec=10

[Install]
WantedBy=multi-user.target
