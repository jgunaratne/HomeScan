# The walkthrough's Nano Banana button posts the frame you are looking at to
# Gemini's image model and shows the photograph it returns. Copy this file to
# .env and fill the key in; serve.mjs reads it and the browser never sees it.
#
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Which image model answers. Defaults to gemini-2.5-flash-image.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
